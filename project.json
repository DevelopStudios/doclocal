{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "doclocal",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "sourceRoot": "src",
  "prefix": "app",
  "tags": [
    "scope:app"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          },
          {
            "glob": "pdf.worker.mjs",
            "input": "node_modules/pdfjs-dist/build/",
            "output": "/"
          }
        ],
        "styles": [
          "src/styles.scss"
        ],
        "outputPath": "dist/doclocal",
        "define": {
          "DOCLOCAL_API_BASE_URL": "'/api'"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all",
          "define": {
            "DOCLOCAL_API_BASE_URL": "'https://doclocal-backend-iuy0x.sevalla.app'"
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "host": "127.0.0.1",
        "proxyConfig": "proxy.conf.mjs"
      },
      "configurations": {
        "production": {
          "buildTarget": "doclocal:build:production"
        },
        "development": {
          "buildTarget": "doclocal:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n"
    },
    "test": {
      "executor": "@angular/build:karma",
      "options": {
        "polyfills": [
          "zone.js",
          "zone.js/testing"
        ],
        "tsConfig": "tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ],
        "styles": [
          "src/styles.scss"
        ]
      }
    }
  }
}
