{
  "name": "data-webllm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/data-webllm/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:data"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
          "assets": [
            {
              "input": "node_modules/@mlc-ai/web-llm",
              "glob": "**/*",
              "output": "dist/doclocal/"
            }
          ],
        "jestConfig": "libs/data-webllm/jest.config.ts",
        "tsConfig": "libs/data-webllm/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
